      "Bash(git worktree add *)",
      "Bash(git worktree list:*)",
      "Bash(git pull --ff-only origin main*)",
      "Bash(env -u GITHUB_TOKEN git pull --ff-only origin main*)",
      "Bash(git pull --ff-only:*)",
      "Bash(env -u GITHUB_TOKEN git pull --ff-only:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",

      "Bash(printf:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(readlink:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(cmp:*)",
      "Bash(command -v:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Bash(touch:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm run lint:*)",
      "Bash(npm:*)",
      "Bash(test:*)",
      "Bash(sleep:*)",
      "Bash(ln -sf:*)",
      "Bash(backend/.venv/bin/*)",
      "Bash(MSG=*)",
      "Bash(REPO=*)",
      "Bash(W=*)",
      "Bash(L=*)",
      "Bash(P=*)",
      "Bash(S=*)",
      "Bash(WORKTREE=*)",
      "Bash(PROJECT_ROOT=*)",
      "Bash(D=_artifacts/*)",
      "Bash(EPIC=epic/*)",
      "Bash(B=https://github.com/*)",
      "Bash(BRANCH=$(git rev-parse *)",
      "Bash(HEAD_SHA=$(git rev-parse *)",

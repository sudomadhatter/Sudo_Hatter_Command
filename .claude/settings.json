      "Bash(env -u GITHUB_TOKEN gh run view:*)",
      "Bash(env -u GITHUB_TOKEN gh run list:*)",
      "Bash(python3 .agents/scripts/jira_feed.py *)",
      "Bash(python3 .agents/scripts/*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(env -u GITHUB_TOKEN python3 .agents/scripts/*)",
      "Bash(python3 --version)",
      "Bash(python3:*)",
      "Bash(acli jira workitem transition *)",

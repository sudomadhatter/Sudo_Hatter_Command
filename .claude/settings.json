{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "ask": [
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .claude/hooks/require-push-approval.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .claude/hooks/guard-cwd-escape.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/session-start-context.sh\"",
            "timeout": 10,
            "statusMessage": "Loading continuity + repo-map..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/scripts/check-repo-map-drift.ps1 -Root \"$CLAUDE_PROJECT_DIR\" -MapPath docs/repo-map.md",
            "timeout": 10,
            "statusMessage": "Checking repo-map drift..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/scripts/check_maps.py --depth3-only",
            "timeout": 10,
            "statusMessage": "Checking depth-3 _artifacts INDEX..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/scripts/record_map_changes.py --nag",
            "timeout": 10,
            "statusMessage": "Reading map-drift journal..."
          }
        ]
      }
    ]
  }
}

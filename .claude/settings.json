{
  "permissions": {
    "ask": [
      "mcp__github__merge_pull_request",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file"
    ],
    "allow": [
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git push origin main*)",
      "Bash(env -u GITHUB_TOKEN git push origin main*)",
      "Bash(git push origin --delete chore/*)",
      "Bash(env -u GITHUB_TOKEN git push origin --delete chore/*)",
      "Bash(git branch -d chore/*)",
      "Bash(git worktree remove *)",
      "Bash(git worktree add *)",
      "Bash(git pull --ff-only origin main*)",
      "Bash(env -u GITHUB_TOKEN git pull --ff-only origin main*)",
      "Bash(acli jira workitem transition *)",
      "Bash(python3 .agents/scripts/jira_feed.py *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git merge-tree:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --list:*)",
      "Bash(git check-ignore:*)",
      "Bash(env -u GITHUB_TOKEN git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git push origin chore/:*)",
      "Bash(python3 .agents/scripts/:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(acli jira workitem view:*)",
      "Bash(acli jira workitem create:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(cd:*)",
      "Bash(git -C * status:*)",
      "Bash(git -C * diff:*)",
      "Bash(git -C * log:*)",
      "Bash(git -C * show:*)",
      "Bash(git -C * rev-parse:*)",
      "Bash(git -C * merge-base:*)",
      "Bash(git -C * ls-files:*)",
      "Bash(git -C * branch --list:*)",
      "Bash(git -C * worktree list:*)",
      "Bash(git -C * check-ignore:*)",
      "Bash(git -C * stash list:*)",
      "Bash(git -C * merge-tree:*)",
      "Bash(git ls-files:*)",
      "Bash(git stash list:*)",
      "Bash(acli jira workitem search:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(readlink:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(cmp:*)",
      "Bash(command -v:*)",
      "Bash(which:*)",
      "Bash(python .agents/scripts/jira_feed.py *)",
      "Bash(python .agents/scripts/:*)",
      "Bash(python -m py_compile:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/hooks/allow-scratchpad.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/hooks/require-push-approval.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/hooks/guard-cwd-escape.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/hooks/allow-readonly-chain.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/hooks/rule-trigger.py",
            "timeout": 10,
            "statusMessage": "Matching prompt against house rules..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "path_glob_match",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/log-rule-load.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/session-start-context.sh\"",
            "timeout": 10,
            "statusMessage": "Loading continuity + repo-map..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/scripts/check-repo-map-drift.ps1 -Root \"$CLAUDE_PROJECT_DIR\" -MapPath docs/repo-map.md",
            "timeout": 10,
            "statusMessage": "Checking repo-map drift..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/scripts/check_maps.py --depth3-only",
            "timeout": 10,
            "statusMessage": "Checking depth-3 _artifacts INDEX..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.agents/hooks/run-hook.sh\" .agents/scripts/record_map_changes.py --nag",
            "timeout": 10,
            "statusMessage": "Reading map-drift journal..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  }
}

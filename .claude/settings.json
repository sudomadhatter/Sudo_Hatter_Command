      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(env -u GITHUB_TOKEN gh pr create:*)",
      "Bash(env -u GITHUB_TOKEN gh pr view:*)",

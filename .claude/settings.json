      "Bash(git config --get:*)",
      "Bash(git branch -d chore/*)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch -f chore/*)",
      "Bash(git push origin main*)",

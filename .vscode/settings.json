{
  // Discover nested git repos under Projects/ (depth 2) so each project's
  // pending changes show in the Source Control panel. Default is 1, which
  // only finds repos at the workspace root and misses Projects/<name>/.
  "git.repositoryScanMaxDepth": 2,
  "git.detectSubmodules": true,
  // Show existing worktrees (the agent lanes under .claude/worktrees/) as repositories in
  // Source Control — native in VS Code 1.103+, off by default. Tracked so the PC and any
  // VS Code profile inherit it (SCC-350).
  "git.detectWorktrees": true,
  "workbench.editor.centeredLayoutFixedWidth": true,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/Projects/AGY_AVIATIONCHAT/backend/.venv/Scripts/python.exe",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": false,
  "workbench.colorTheme": "Dark Modern",
  "workbench.view.alwaysShowHeaderActions": false,
  "workbench.editor.alwaysShowEditorActions": false,
  "workbench.editor.autoLockGroups": {
    "mainThreadWebview-markdown.preview": true
  },
  // Zoo Code (Roo Code's community continuation) — workspace-scoped so the allowlists travel
  // via git to BOTH machines (SCC-346). Namespace is zoo-code.*, NOT the retired roo-cline.*.
  // Both lists are PREFIX matchers over the whole command string, and a deny only wins when its
  // prefix actually matches — so no allow entry may be a prefix of a denied family's escape
  // spelling. That is why there is NO bare "git -C" here: `git -C . push --force` starts with
  // "git -C" and with no deny entry, so the one allow row would have bypassed the whole
  // destructive set (found at review, SCC-346). Same stable command families as
  // .claude/settings.json permissions.allow — both interpreter spellings, no machine paths.
  "zoo-code.useAgentRules": true,
  "zoo-code.allowedCommands": [
    "git status", "git diff", "git log", "git show", "git fetch", "git rev-parse",
    "git merge-base", "git merge-tree", "git worktree list", "git branch --list",
    "git ls-files", "git check-ignore", "git stash list", "git add", "git commit",
    "python3 .agents/scripts/", "python .agents/scripts/",
    "python3 -m py_compile", "python -m py_compile",
    "acli jira workitem view", "acli jira workitem search",
    "ls", "cat", "head", "tail", "sed -n", "grep", "rg", "find", "wc", "diff",
    "cp", "mkdir", "echo", "printf", "sort", "uniq", "awk", "cut", "tr",
    "basename", "dirname", "readlink", "file", "stat", "du", "cmp",
    "command -v", "which"
  ],
  "zoo-code.deniedCommands": [
    "rm -rf", "rm -r", "sudo",
    "git push --force", "git push -f", "git push origin main",
    "git reset --hard", "git clean", "git checkout main", "git branch -D",
    "git add -A", "git add .", "git add -u",
    "Remove-Item -Recurse", "del /s", "rmdir /s",
    "dd if=", "mkfs", "chmod -R 777"
  ]
}
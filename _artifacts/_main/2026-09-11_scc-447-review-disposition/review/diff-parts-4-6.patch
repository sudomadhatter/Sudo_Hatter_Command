+# A mermaid node: `ID["label"]`, `ID{"label"}` or `ID(["label"])`, wherever it sits on the line.
+# Edge labels (`-- "text" -->`) are preceded by a space, not by an id and a bracket, so they miss.
+NODE_RX = re.compile(r'(\w+)(?:\(\[|\[|\{)"([^"]*)"(?:\]\)|\]|\})')

-def _fit_lines(body: list[str], room: int) -> int:
-    """How many whole lines fit in `room` chars, each costing its length plus one newline."""
-    used = keep = 0
-    for line in body:
-        if used + len(line) + 1 > room:
-            break
-        used += len(line) + 1
-        keep += 1
-    return keep

-    for raw in patch_lines:
-        if raw.startswith("@@"):
-            if hunk and count > 0 and start <= line < start + count:
-                return hunk
-            hunk = [raw]
-            match = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", raw)
-            start = int(match.group(1)) if match else 0
-            count = int(match.group(2) or "1") if match else 0
-        elif hunk:
-            hunk.append(raw)
-    if hunk and count > 0 and start <= line < start + count:
-        return hunk
-    return []

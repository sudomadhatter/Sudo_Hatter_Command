+    for p in paths:
+        rel = p.replace("\\", "/").lstrip("./")
+        if rel == INERT_REL or rel.startswith(LAW_PREFIXES):
+            continue
+        if any(seg in SERVED_SEGMENTS for seg in PurePosixPath(rel).parts[:-1]):
+            continue

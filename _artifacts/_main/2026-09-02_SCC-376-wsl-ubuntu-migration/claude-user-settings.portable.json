{
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git push origin main*)",
      "Bash(env -u GITHUB_TOKEN git push origin main*)",
      "Bash(git push origin --delete chore/*)",
      "Bash(env -u GITHUB_TOKEN git push origin --delete chore/*)",
      "Bash(git branch -d chore/*)",
      "Bash(git worktree remove *)",
      "Bash(git worktree add *)",
      "Bash(git pull --ff-only origin main*)",
      "Bash(env -u GITHUB_TOKEN git pull --ff-only origin main*)",
      "Bash(acli jira workitem transition *)",
      "Bash(python3 .agents/scripts/jira_feed.py *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git merge-tree:*)",
      "Bash(git worktree list:*)",
      "Bash(git branch --list:*)",
      "Bash(git check-ignore:*)",
      "Bash(env -u GITHUB_TOKEN git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(python3 .agents/scripts/*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(acli jira workitem view:*)",
      "Bash(acli jira workitem create:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(cd:*)",
      "Bash(git ls-files:*)",
      "Bash(git stash list:*)",
      "Bash(acli jira workitem search:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(readlink:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(cmp:*)",
      "Bash(command -v:*)",
      "Bash(which:*)",
      "Bash(gh:*)",
      "Bash(env -u GITHUB_TOKEN gh:*)",
      "Bash(acli:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pytest:*)",
      "Bash(sed:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(jq:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(mv:*)",
      "Bash(rsync:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh 'Claude Code' 'Input needed or task update'",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh 'Claude Code' 'Turn completed'",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ~/.conductor/hook.sh ]; then ~/.conductor/hook.sh; fi",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "uploads.github.com",
        "*.githubusercontent.com",
        "sudo-command.atlassian.net",
        "api.atlassian.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Sudo_Hatter_Command",
        "~/Sudo_Hatter_Command/.git",
        "~/Sudo_Hatter_Command/.claude/worktrees",
        "~/Sudo_Hatter_Command/Projects",
        "/tmp",
        "/private/tmp"
      ]
    },
    "excludedCommands": [
      "acli",
      "acli *",
      "gh",
      "gh *",
      "python3 *jira_feed.py *",
      "python3 *task_preflight.py *"
    ]
  },
  "theme": "dark",
  "editorMode": "normal",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "effortLevel": "xhigh"
}

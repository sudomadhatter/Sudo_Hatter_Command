# ============================================================================
# Command Center — Environment Configuration
# ============================================================================
# SETUP:
#   1. Copy this file:  cp .env.example .env       (PowerShell: copy .env.example .env)
#   2. Fill in the values you need — see the tiers below
#   3. .env is gitignored. This file is NOT: never paste a real value in here.
#
# These are the keys the COMMAND CENTER itself uses. Keys your application needs
# (Firebase, Gemini, GCP, database URLs) live in the project's own .env — the
# project skeleton ships its own .env.example for those. Two files, two jobs.
# ============================================================================


# ============================================================================
# REQUIRED — nothing works without these
# ============================================================================

# GitHub personal access token (classic), scopes: repo, workflow
# Used for: creating repos, pushing branches, opening PRs, dispatching workflows.
# Get one at: https://github.com/settings/tokens  → "Generate new token (classic)"
GITHUB_PAT_CLASSIC=ghp_your_token_here

# Your GitHub account or org name — where new project repos get created.
GITHUB_REPO=your-github-user


# ============================================================================
# MODELS — you need at least ONE of these
# ============================================================================

# Anthropic API key. NOT required if you drive Claude Code with a Claude
# subscription (Pro/Max) — the CLI authenticates on its own and ignores this.
# Set it only for API-billed usage or headless/automated runs.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional beta feature headers for the Anthropic API. Leave blank unless you
# have been told to set one.
ANTHROPIC_BETA_HEADER=

# OpenRouter key — ONLY needed for the hybrid autopilot lane, which runs the
# code-writing stage on a cheaper non-Claude model so it costs no Claude tokens.
# Skip it entirely if you are not using that lane.
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ============================================================================
# OPTIONAL — each one turns on a specific feature. Blank = feature off.
# ============================================================================

# --- Telegram: get paged on your phone when a long run finishes or breaks ---
# Create a bot with @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sentry: pull real production errors into an incident workflow ---
# Get a token at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
# Shared secret if you point Sentry alert webhooks back at your own endpoint.
SENTRY_WEBHOOK_SECRET=

# --- Scheduled/remote runs: let an external trigger fire an agent run ---
ROUTINE_FIRE_URL=
ROUTINE_BEARER_TOKEN=

# Set to 1 to stop automated incident handling from firing (a kill switch you
# can flip without deleting any of the config above).
INCIDENTS_PAUSED=0


# ============================================================================
# NOTES
# ============================================================================
# - A blank optional key is fine. Commands that need it will say so plainly
#   rather than failing halfway through.
# - Never commit .env. Never paste a real value into .env.example.
# - Rotate a key the moment it appears anywhere it should not — a leaked token
#   is a leaked token even if the commit was deleted afterwards.
# ============================================================================

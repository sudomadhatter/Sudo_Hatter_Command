# ==============================================================================
# Sudo_Hatter_Command — Master Environment Configuration Template (.env.example)
# Single source of truth for environment variable keys across the platform.
# Copy to .env and fill in active credentials. NEVER commit raw credentials to git.
# ==============================================================================

# --- AI & LLM API Keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_BETA_HEADER=
GEMINI_API_KEY=
Z_AI_API_KEY=

# --- GitHub & CI/CD Integration ---
GITHUB_PAT_CLASSIC=
GITHUB_PAT_INCIDENT=
GITHUB_REPO=sudomadhatter/Sudo_Hatter_Command

# --- Google Cloud & Firebase ---
GCP_PROJECT_ID=
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_SEARCH_DB1_ID=
VERTEX_SEARCH_DB2_ID=
VERTEX_SEARCH_LOCATION=
CLOUD_RUN_SERVICE=

# --- Firebase Web App Configuration ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Auth & Security Secrets ---
JWT_ADMIN_SECRET=
SENTRY_WEBHOOK_SECRET=
SENTRY_AUTH_TOKEN=
ROUTINE_BEARER_TOKEN=

# --- Telegram & Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WAITLIST_TEAM_EMAIL=
WAITLIST_LOGO_URL=

# --- Runtime & Development Flags ---
DEBUG=true
LOG_LEVEL=INFO
FASTAPI_RELOAD=false
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
TARGET=local
INCIDENTS_PAUSED=false
ROUTINE_FIRE_URL=

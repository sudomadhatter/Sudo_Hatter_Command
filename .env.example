# Command Center — optional integrations
# Copy to .env only when needed. .env is gitignored; never put a real value in this example.

# GitHub automation. Interactive work may use `gh auth login` instead.
GITHUB_PAT_CLASSIC=
GITHUB_REPO=your-github-user-or-org

# Model APIs. A signed-in desktop agent may not need an API key.
ANTHROPIC_API_KEY=
ANTHROPIC_BETA_HEADER=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
Z_AI_API_KEY=

# Optional error/notification integrations.
SENTRY_AUTH_TOKEN=
SENTRY_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional remote-run controls.
ROUTINE_FIRE_URL=
ROUTINE_BEARER_TOKEN=
INCIDENTS_PAUSED=0

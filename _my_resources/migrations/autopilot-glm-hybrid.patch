+# --- GLM / alternate Dev-lane endpoint normalization -------------------------------------
+# -Glm is sugar for "route the Dev lane at Z.ai's GLM 5.2 Anthropic-compatible endpoint". It only
+# fills in defaults the user did NOT set, so an explicit -DevBaseUrl / -DevModel always wins.
+if ($Glm) {
+    if (-not $DevBaseUrl) { $DevBaseUrl = "https://api.z.ai/api/anthropic" }
+    if ($DevModel -eq "claude-opus-4-8") { $DevModel = "glm-5.2" }   # only override the untouched default
+}
+# Resolve the Dev-lane auth token: explicit flag > env (Z_AI_API_KEY / GLM_API_KEY / ANTHROPIC_AUTH_TOKEN).
+# Keeping it in the env (not on the command line) means it never lands in the per-story monitoring log.
+if ($DevBaseUrl -and -not $DevAuthToken) {
+    foreach ($v in @('Z_AI_API_KEY','GLM_API_KEY','ANTHROPIC_AUTH_TOKEN')) {
+        $val = [Environment]::GetEnvironmentVariable($v)
+        if ($val) { $DevAuthToken = $val; break }
+    }
+}
+# .env fallback: if still no token, read a gitignored .env - searching the project root and up to two
+# parents (…/Projects, …/<command-center>), so ONE lobby-level .env serves every child project and the
+# key survives the Windows "new User env var not seen by an already-open shell" propagation gap. Never
+# echoed anywhere (only assigned to the child's ANTHROPIC_AUTH_TOKEN), so it stays out of every log.
+if ($DevBaseUrl -and -not $DevAuthToken) {
+    $projRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
+    $envDirs  = @($projRoot, (Split-Path $projRoot -Parent), (Split-Path (Split-Path $projRoot -Parent) -Parent))
+    foreach ($d in ($envDirs | Where-Object { $_ })) {
+        $envFile = Join-Path $d ".env"
+        if (Test-Path $envFile) {
+            foreach ($ln in (Get-Content -LiteralPath $envFile -ErrorAction SilentlyContinue)) {
+                if ($ln -match '^\s*(?:export\s+)?(?:Z_AI_API_KEY|GLM_API_KEY|ANTHROPIC_AUTH_TOKEN)\s*=\s*(.+?)\s*$') {
+                    $DevAuthToken = $Matches[1].Trim().Trim('"').Trim("'"); break
+                }
+            }
+        }
+        if ($DevAuthToken) { break }
+    }
+}
+if ($DevBaseUrl -and -not $DevAuthToken -and -not $DryRun) {
+    throw "Dev-lane endpoint -DevBaseUrl is set ($DevBaseUrl) but no auth token was found. Pass -DevAuthToken <key> or set `$env:Z_AI_API_KEY (the Z.ai coding-plan key), then re-run. (A -DryRun preview is allowed without a key.)"
+}
+if ($DevBaseUrl -and $DevModel -like 'claude-*') {
+    throw "Misconfig: -DevBaseUrl points at a non-Anthropic endpoint but -DevModel is '$DevModel' (a Claude id). Set -DevModel to that provider's model id (e.g. glm-5.2)."
+}

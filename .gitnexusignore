# GitNexus index scope — HOME BASE ONLY, optimized as the PROJECT MANAGER map.
# Signal = the master toolkit (.agents/), routing/docs infra (AGENTS.md, router.md,
# docs/, _system/). Noise = child-project session artifacts, personal documents,
# vendor BMAD install, test fixtures — excluded below.
#
# Why this file (not .gitignore): Projects/ is intentionally NOT gitignored so
# VS Code can auto-discover the nested repos. But GitNexus walks the filesystem
# (it does not respect submodule boundaries), so without this it descends into
# every submodule working tree and balloons the lobby map from ~1.5k symbols to
# 100k+ nodes. .gitnexusignore scopes the index without touching .gitignore.

# Independent submodule repos — each has its OWN GitNexus map. NEVER index here.
/Projects/

# Historical session records from child projects (append-only walkthroughs/plans).
/_artifacts/

# Personal documents, notes, diagrams, open tasks.
/_my_resources/

# Vendor BMAD install (configs + vendor scripts we don't edit) and its output.
/_bmad/
/_bmad-output/

# Routing test fixtures.
/_routing-canary/

# Re-include the master toolkit — the lobby's REAL infra (scripts, hooks, skills).
# GitNexus auto-filters dot-directories by default; negation opts it back in (#771).
!/.agents/

# NOTE: .claude/ .opencode/ .agent/ .antigravity/ stay auto-filtered ON PURPOSE —
# they are sync-target MIRRORS of .agents/; indexing them would duplicate every
# symbol 3-4x. Edit the master in .agents/, never the mirrors.

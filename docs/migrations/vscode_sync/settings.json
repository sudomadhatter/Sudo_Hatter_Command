{
    "workbench.activityBar.location": "top",
    "git.enableSmartCommit": true,
    "git.autofetch": true,
    "chat.mcp.gallery.enabled": true,

    // Ported from Antigravity IDE user settings (SCC-346 transition, 2026-08-29).
    // Deliberately NOT ported: git.path shim (git-flat-scm — Antigravity SCM fix only),
    // antigravity.* marketplace keys, roo-cline.* (retired; zoo-code.* lives in the
    // tracked workspace .vscode/settings.json so it travels via git).
    "editor.minimap.enabled": false,
    "git.confirmSync": false,
    // Show existing git worktrees (the agent lanes under .claude/worktrees/) as repositories
    // in the Source Control view — VS Code 1.103+ native support, off by default (SCC-346).
    "git.detectWorktrees": true,
    "scm.alwaysShowRepositories": true,
    "scm.compactFolders": false,
    "githubPullRequests.notifications": "pullRequests",
    "workbench.editor.closeOnFileDelete": true,
    "window.customTitleBarVisibility": "auto",
    "markdown-preview-enhanced.previewColorScheme": "systemColorScheme",

{
  "mcpServers": {
    "md-feedback": {
      "command": "npx",
      "args": [
        "-y",
        "md-feedback"
      ]
    },
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server"
      ],
      "env": {
        "SENTRY_ORG": "aviationchat"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--caps",
        "vision,pdf,devtools"
      ]
    }
  }
}

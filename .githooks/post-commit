#!/bin/sh
# post-commit — map-drift RECORDER (non-blocking).
# Classifies the just-made commit's changes into the repo-map/INDEX judgment categories and appends
# ONE line to the machine-local journal (docs/.maps-journal.jsonl). post-commit fires AFTER the commit
# is sealed, so it can never block or corrupt a commit; every error is swallowed so a broken recorder
# is invisible to your workflow. The journal is a CACHE — check_maps.py (git diff vs anchor) stays truth.
#
# Enable per machine (once):  python3 docs/migrations/scripts/arm_hooks_include.py .
#   (PC: python. NOT a bare `git config core.hooksPath` - see SCC-323.)
# It is shared/tracked, so every clone that runs that one command gets the recorder.

# Same probe order as the two armed gates (SCC-49): python3 -> python -> py. This one is a
# non-blocking recorder, so a miss costs a journal line rather than a check — but two probe
# orders in one repo is how they drift, and `python` first is wrong on the Mac, which has
# only `python3`.
PY=""
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
[ -n "$PY" ] && "$PY" .agents/scripts/record_map_changes.py --commit HEAD >/dev/null 2>&1

# SCC-113 — the second recorder: a keyed branch's first commit moves its ticket to
# `In Progress`. Same non-blocking contract as the drift journal above; it is a separate
# script so the suite can drive it directly (test_jira_start_hook.py), exactly as commit-msg
# delegates to commit-msg-jira.sh and sop-currency.sh.
#
# GUARD (SCC-32): a worktree cut from a commit before this script existed has no script to
# exec, and a bare exec on a missing file kills the hook. Missing -> skip, silently.
JIRA_START="$(git rev-parse --show-toplevel 2>/dev/null)/.agents/scripts/git-hooks/post-commit-jira-start.sh"
[ -x "$JIRA_START" ] && "$JIRA_START"

exit 0

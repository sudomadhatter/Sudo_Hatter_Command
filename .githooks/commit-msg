#!/bin/sh
# commit-msg — two gates, run in order. Both must pass.
#
#   1. jira        every commit carries this repo's work-item key   (commit-msg-jira.sh)
#   2. sop         usage changes move the SOP quick-reference       (sop-currency.sh)
#
# GUARD (SCC-32): `--show-toplevel` resolves to the WORKTREE root, not the main checkout, so a worktree
# cut from a commit before a script existed has no script to exec — and a bare `exec` on a missing file
# kills the commit outright with a shell error. That is a hard door where the design calls for a loud
# alarm (guide §10), and it hit a real lane the day the jira gate shipped. Missing script -> say so, allow.
#
# NOTE (SCC-31): this used to `exec` the jira hook, which replaces the shell process — anything added
# after it would silently never run. With two gates it must call and check, not exec-and-forget. The
# final gate is still exec'd so its exit code is the hook's.
ROOT="$(git rev-parse --show-toplevel)"

JIRA="$ROOT/.agents/scripts/git-hooks/commit-msg-jira.sh"
if [ ! -x "$JIRA" ]; then
  echo "  ⚠ jira commit gate not present in this worktree ($JIRA) — commit allowed, unchecked."
  echo "    Merge/rebase onto a commit that carries .agents/scripts/git-hooks/ to re-arm it."
else
  "$JIRA" "$@" || exit $?
fi

SOP="$ROOT/.agents/scripts/git-hooks/sop-currency.sh"
[ -x "$SOP" ] || exit 0
exec "$SOP" "$@"

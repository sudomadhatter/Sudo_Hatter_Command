    { "path": ".agents/maintained-projects.txt", "replaceWith": "replacements/maintained-projects.txt" },
    { "path": "router.md", "replaceWith": "replacements/router.md" },
    { "path": ".training-mode", "replaceWith": "replacements/training-mode-sentinel" },
    { "path": ".agents/jira.conf.example", "replaceWith": "replacements/jira-conf.example" },
    { "path": "README.md", "replaceWith": "replacements/lobby-README.md" }

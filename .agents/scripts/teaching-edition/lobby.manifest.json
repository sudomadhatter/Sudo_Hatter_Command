{
  "name": "command-center teaching edition",
  "source": "../../..",

  "_comment_include": "The command-center shell: shared toolkit, platform doors, gates, BMAD module, operator docs, and root routing/config. Projects and session history are deliberately empty. The paired project skeleton remains its own maintained repository and is cloned later by smh-new-project.",
  "include": [
    ".agents",
    ".claude",
    ".opencode",
    ".antigravity",
    ".agent",
    ".githooks",
    ".vscode",
    "_bmad",
    "docs",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "router.md",
    "opencode.json",
    ".mcp.json",
    ".env.example",
    ".gitattributes",
    ".gitignore",
    "requirements.txt",
    "requirements-tdad.txt"
  ],

  "_comment_exclude": "Active bindings, machine-local state, source-only export machinery, and domain-specific incident doors do not belong in a fresh shell.",
  "exclude": [
    ".agents/active-project.txt",
    ".agents/jira.conf",
    ".agents/project-own.txt",
    ".agents/scripts/git-hooks/JIRA-ENFORCE",
    ".agents/scripts/export-teaching-edition.ps1",
    ".agents/scripts/teaching-edition",
    ".agents/scripts/tests/test_teaching_edition.py",
    "docs/.maps-journal.jsonl",
    "docs/.maps-state.json",
    ".agents/commands/sentry-security-team-avch.md",
    ".agents/skills/sentry-security-team-avch",
    ".agents/workflows/sentry-security-team-avch.md",
    ".claude/skills/sentry-security-team-avch",
    ".opencode/commands/sentry-security-team-avch.md",
    ".claude/settings.local.json",
    ".claude/scratchpad-root"
  ],

  "_comment_emptyDirs": "Top-level shape only; no project names, personal notes, BMAD output, or session history cross the export boundary.",
  "emptyDirs": ["_artifacts", "_bmad-output", "Projects", "_my_resources"],

  "excludeAnywhere": [
    ".git",
    ".venv",
    ".venv_stale",
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".gitnexus",
    ".code-review-graph",
    "_artifacts",
    "_bmad-output",
    "_my_resources",
    "Projects",
    "scratch",
    "_routing-canary"
  ],

  "_comment_substitutions": "Case-sensitive content substitutions run before whole-file transforms. The final leak scan is case-insensitive and checks both content and paths.",

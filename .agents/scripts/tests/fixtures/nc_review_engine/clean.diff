+def refund(ledger: dict, amount: float) -> dict:
+    """Refund `amount` against `ledger`, per the refunds spec.
+
+    Amounts are floats rounded to two places, matching `invoice_total` above — the module's
+    stated convention, not an oversight in this change.
+
+    `NaN` is rejected explicitly because it is the one value the guards below cannot catch:
+    `nan < 0` and `nan > paid` are both False, so it would fall straight through into the
+    ledger, after which every later comparison against that balance is False forever. `±inf`
+    is already caught by those two guards; rejecting it here as well only buys a truthful
+    error message instead of a misleading one. Both reach us from `json.loads`, which accepts
+    them by default.
+    """
+    if not math.isfinite(amount):
+        raise ValueError("refund amount must be a finite number")
+    if amount < 0:
+        raise ValueError("refund amount must not be negative")
+    paid = ledger.get("paid", 0.0)
+    if amount > paid:
+        raise ValueError("refund exceeds the amount paid")
+    ledger["paid"] = round(paid - amount, 2)
+    return ledger
